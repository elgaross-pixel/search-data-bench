---
import BaseLayout from '../core/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import { websiteSchema } from '../core/schema';
---
<BaseLayout title={siteConfig.site.name} description={siteConfig.site.description} schema={websiteSchema()}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow"><span class="signal-dot"></span> Independent research lab</p>
        <h1>Search data,<br/><span>tested.</span></h1>
        <p class="lede">{siteConfig.site.tagline}</p>
        <p class="hero-copy">Evidence-led benchmarks and buyer research for search data providers, SEO APIs, SERP APIs, and AI search intelligence tools.</p>
        <p class="hero-actions"><a class="button" href="/research/">Explore the research <span aria-hidden="true">→</span></a><a class="text-link" href="/methodology/">How we test</a></p>
      </div>
      <aside class="lab-panel" aria-label="Research principles">
        <p class="panel-kicker">SDB / Research protocol</p>
        <div class="metric"><span>Inputs</span><strong>Frozen before tests</strong></div>
        <div class="metric"><span>Missing data</span><strong>Preserved</strong></div>
        <div class="metric"><span>Evidence</span><strong>Graded by source</strong></div>
        <div class="metric"><span>Winner score</span><strong>Never fabricated</strong></div>
        <div class="panel-status"><span class="signal-dot"></span> Methodology public</div>
      </aside>
    </div>
  </section>
  <section class="section research-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Research desk</p><h2>Current research</h2></div><a class="section-link" href="/research/">View all research →</a></div>
      <div class="cards">
        <article class="card card-featured"><div class="card-top"><span class="status-badge badge-frozen">Protocol frozen</span><span class="card-index">01</span></div><h3><a href="/benchmarks/search-data-benchmark-01/">Search Data Benchmark #1</a></h3><p>Fixed workloads for DataForSEO, SE Ranking API and Mangools API. Results wait for comparable execution.</p><a class="card-link" href="/benchmarks/search-data-benchmark-01/">Open benchmark →</a></article>
        <article class="card"><div class="card-top"><span class="status-badge badge-verified">Hands-on</span><span class="card-index">02</span></div><h3><a href="/reviews/se-ranking-api/">SE Ranking API</a></h3><p>Frozen 25-keyword API run with limits, rate behaviour and provenance preserved.</p><a class="card-link" href="/reviews/se-ranking-api/">Read evidence →</a></article>
        <article class="card"><div class="card-top"><span class="status-badge badge-documented">Documented</span><span class="card-index">03</span></div><h3><a href="/reviews/dataforseo/">DataForSEO</a></h3><p>API coverage mapped from primary documentation with explicit live-test boundaries.</p><a class="card-link" href="/reviews/dataforseo/">Read evidence →</a></article>
        <article class="card"><div class="card-top"><span class="status-badge badge-mixed">Mixed evidence</span><span class="card-index">04</span></div><h3><a href="/reviews/mangools-api/">Mangools API</a></h3><p>Hands-on product evidence separated from currently documented API capabilities.</p><a class="card-link" href="/reviews/mangools-api/">Read evidence →</a></article>
      </div>
    </div>
  </section>
  <section class="section principles">
    <div class="container principles-grid">
      <div><p class="eyebrow">Research standard</p><h2>Evidence before verdicts.</h2></div>
      <div><p class="principle-copy">We freeze inputs before tests, preserve missing and limited results, separate hands-on findings from provider documentation, and avoid forcing proprietary metrics into false equivalence.</p><a class="text-link" href="/methodology/">Read the methodology →</a></div>
    </div>
  </section>
</BaseLayout>
