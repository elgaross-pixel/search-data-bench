---
import { siteConfig } from '../../site.config';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.site.name} home`}>
      <span aria-hidden="true">{siteConfig.brand.logoText}</span>
      {siteConfig.site.name}
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {siteConfig.navigation.primary.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
