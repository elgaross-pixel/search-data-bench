---
import { siteConfig } from '../../site.config';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label={`${siteConfig.site.name} home`}>
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="brand-name">{siteConfig.site.name}</span>
      </a>
      <p class="footer-note">Independent benchmarks for Search, SEO &amp; AI data APIs.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      {siteConfig.navigation.footer.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="container footer-bottom"><small>&copy; {new Date().getFullYear()} {siteConfig.site.name}</small><small>Evidence before verdicts.</small></div>
</footer>
