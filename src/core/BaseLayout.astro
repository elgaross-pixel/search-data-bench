---
import '../styles/global.css';
import '../brand/theme.css';
import Header from '../brand/Header.astro';
import Footer from '../brand/Footer.astro';
import SEO from './SEO.astro';
import Analytics from './Analytics.astro';
import EventTracker from './EventTracker.astro';
import { siteConfig } from '../../site.config';

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
---
<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.brand.themeColor} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.brand.favicon} />
    <SEO {...props} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <EventTracker />
  </body>
</html>
